438:     <!-- ============ JAVASCRIPT ANIMATIONS ============ -->
439:     <script>
440:         document.addEventListener('DOMContentLoaded', () => {
441:             // Scroll Reveal Animation via IntersectionObserver
442:             const observerOptions = {
443:                 threshold: 0.1,
444:                 rootMargin: '0px 0px -40px 0px'
445:             };
446: 
447:             const observer = new IntersectionObserver((entries) => {
448:                 entries.forEach(entry => {
449:                     if (entry.isIntersecting) {
450:                         entry.target.classList.add('is-visible');
451:                     }
452:                 });
453:             }, observerOptions);
454: 
455:             document.querySelectorAll('.reveal-on-scroll').forEach(el => {
456:                 observer.observe(el);
457:             });
458: 
459:             // ScrollSpy for Header Navigation
460:             const navLinks = document.querySelectorAll('.nav-link');
461:             const sections = document.querySelectorAll('section[id]');
462:             
463:             function updateNavActiveState() {
464:                 let current = '';
465:                 
466:                 // Determine which section is currently in view
467:                 sections.forEach(section => {
468:                     const sectionTop = section.offsetTop;
469:                     // Trigger active state a bit before the section hits the very top
470:                     if (window.scrollY >= (sectionTop - 150)) {
471:                         current = '#' + section.getAttribute('id');
472:                     }
473:                 });
474: 
475:                 // Update active classes
476:                 navLinks.forEach(link => {
477:                     link.classList.remove('text-emerald-700');
478:                     link.classList.add('text-slate-600');
479:                     if (link.getAttribute('href') === current) {
480:                         link.classList.remove('text-slate-600');
481:                         link.classList.add('text-emerald-700');
482:                     }
483:                 });
484: 
485:                 // If at the very top (hero section), maybe remove active state from others
486:                 if (window.scrollY < 100) {
487:                     navLinks.forEach(link => {
488:                         link.classList.remove('text-emerald-700');
489:                         link.classList.add('text-slate-600');
490:                         if (link.textContent.trim() === 'Beranda') {
491:                             link.classList.remove('text-slate-600');
492:                             link.classList.add('text-emerald-700');
493:                         }
494:                     });
495:                 }
496:             }
497: 
498:             // Listen to scroll events
499:             window.addEventListener('scroll', updateNavActiveState);
500:             
501:             // Also run once on load
502:             updateNavActiveState();
503:         });
504:     </script>
505: </body>
506: </html>